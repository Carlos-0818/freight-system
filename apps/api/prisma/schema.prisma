generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DRIVER
  LINEHAUL_DRIVER
  CLERK
  SUPERVISOR
}

enum TrackingEventType {
  RECEIVED
}

enum TrackingInputMethod {
  MANUAL
  CAMERA
}

model Station {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users          User[]
  trackingEvents TrackingEvent[]

  originatingShipments Shipment[] @relation("ShipmentOriginStation")
  destinationShipments Shipment[] @relation("ShipmentDestinationStation")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         UserRole
  isActive     Boolean  @default(true)
  stationId    Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  station                Station         @relation(fields: [stationId], references: [id], onDelete: Restrict)
  createdShipments       Shipment[]      @relation("ShipmentCreatedBy")
  collectedPayments      PaymentRecord[] @relation("PaymentCollectedBy")
  recordedPayments       PaymentRecord[] @relation("PaymentRecordedBy")
  operatedTrackingEvents TrackingEvent[] @relation("TrackingEventOperator")
  recordedTrackingEvents TrackingEvent[] @relation("TrackingEventRecorder")

  @@index([stationId])
}

model Shipment {
  id                   Int      @id @default(autoincrement())
  paperNumber          String   @unique
  originStationId      Int
  destinationStationId Int
  createdById          Int
  driverQuotedAmount   Decimal? @db.Decimal(12, 2)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  originStation      Station @relation("ShipmentOriginStation", fields: [originStationId], references: [id], onDelete: Restrict)
  destinationStation Station @relation("ShipmentDestinationStation", fields: [destinationStationId], references: [id], onDelete: Restrict)
  createdBy          User    @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  packages       Package[]
  paymentRecords PaymentRecord[]

  @@index([originStationId])
  @@index([destinationStationId])
  @@index([createdById])
}

model Package {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique
  shipmentId            Int
  sequence              Int
  needsHandover         Boolean  @default(false)
  latestTrackingEventId Int?     @unique
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  shipment            Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  trackingEvents      TrackingEvent[] @relation("PackageTrackingHistory")
  latestTrackingEvent TrackingEvent?  @relation("PackageLatestTrackingEvent", fields: [latestTrackingEventId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, sequence])
}

model PaymentRecord {
  id            Int      @id @default(autoincrement())
  shipmentId    Int
  amount        Decimal  @db.Decimal(12, 2)
  collectedById Int
  recordedById  Int
  collectedAt   DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  collectedBy User     @relation("PaymentCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict)
  recordedBy  User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([shipmentId, collectedAt])
  @@index([collectedById])
  @@index([recordedById])
}

model TrackingEvent {
  id           Int                 @id @default(autoincrement())
  requestId    String              @unique @db.Uuid
  packageId    Int
  type         TrackingEventType
  stationId    Int
  operatorId   Int
  recordedById Int
  inputMethod  TrackingInputMethod
  occurredAt   DateTime            @db.Timestamptz(3)
  recordedAt   DateTime            @default(now()) @db.Timestamptz(3)

  package    Package @relation("PackageTrackingHistory", fields: [packageId], references: [id], onDelete: Restrict)
  station    Station @relation(fields: [stationId], references: [id], onDelete: Restrict)
  operator   User    @relation("TrackingEventOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("TrackingEventRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  latestForPackage Package? @relation("PackageLatestTrackingEvent")

  @@index([packageId, occurredAt, id])
  @@index([stationId, occurredAt])
  @@index([operatorId])
  @@index([recordedById])
}
