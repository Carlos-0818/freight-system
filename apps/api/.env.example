DATABASE_URL="postgresql://freight_dev:local_dev_password@127.0.0.1:5433/freight_dev?schema=public"

# 執行環境：development、test 或 production
NODE_ENV=development

# 開發用 seed 初始密碼，請在本機 .env 填入。
# 僅用於新建測試帳號，不會重設既有帳號密碼。
SEED_PASSWORD=

# JWT 簽章密鑰：請在本機 .env 填入隨機產生的值
JWT_SECRET=

# Access Token 有效時間，單位為秒
JWT_EXPIRES_IN_SECONDS=3600